    <string name="tarot_random_result">隨機抽到的塔羅牌</string>
    <string name="tarot_love_trend_title">最近的感情運勢走向</string>
    <string name="tarot_try_again">再抽一張塔羅牌</string>
    <string name="tarot_guide_detail_title">塔羅牌解讀總覽</string>
    <string name="tarot_guide_detail_subtitle">這頁把塔羅牌系統拆成更好理解的導覽，先看 22 張大阿爾克那，再看小阿爾克那的四組牌花與數字、宮廷牌在解牌時代表的方向。</string>
    <string name="tarot_major_section_title">大阿爾克那</string>
    <string name="tarot_major_section_body">大阿爾克那通常對應更核心的人生課題、關係轉折與內在成長。抽到時，往往代表目前的主題不只是小情緒，而是更深一層的選擇與變化。</string>
    <string name="tarot_minor_section_title">小阿爾克那</string>
    <string name="tarot_minor_section_body">小阿爾克那更貼近日常事件、互動細節與現實節奏。解讀時通常會先看牌花代表哪個生活面向，再看數字或人物牌代表事情走到哪個階段。</string>
    <string name="tarot_minor_suits_title">四個牌花代表什麼</string>
    <string name="tarot_minor_ranks_title">數字牌與宮廷牌怎麼看</string>
    <string name="tarot_major_badge">大阿爾克那</string>
    <string name="tarot_minor_badge">小阿爾克那</string>
    <string name="tarot_rank_badge">牌位說明</string>
    <string name="tarot_card_1_name">戀人 The Lovers</string>
    <string name="tarot_card_1_keyword">關係選擇 / 真心靠近 / 雙向回應</string>
    <string name="tarot_card_1_meaning">這張牌代表最近的感情課題不只是「喜不喜歡」，而是你願不願意更真實地說出需求。若你正在曖昧中，關係很可能往更清楚的方向推進。</string>
    <string name="tarot_card_2_name">星星 The Star</string>
    <string name="tarot_card_2_keyword">修復期待 / 慢慢回暖 / 重新相信</string>
    <string name="tarot_card_2_meaning">這張牌偏向溫柔修復。它不會讓關係一下子大逆轉，但很適合讓失望、疲憊過後的心重新長出一點點期待。</string>
    <string name="tarot_card_3_name">女祭司 The High Priestess</string>
    <string name="tarot_card_3_keyword">先觀察 / 直覺很準 / 不急著表態</string>
    <string name="tarot_card_3_meaning">這張牌提醒你，現在比起追問答案，更適合先相信自己的直覺。很多訊號其實你已經感覺到了，只是還沒有真正承認。</string>
    <string name="tarot_card_4_name">太陽 The Sun</string>
    <string name="tarot_card_4_keyword">明朗互動 / 好感升溫 / 更有安全感</string>
    <string name="tarot_card_4_meaning">太陽牌代表近期的感情氛圍會逐漸變亮。適合主動聊天、安排見面，或者把之前不敢說的喜歡，用更輕鬆自然的方式表達出去。</string>
    <string name="tarot_card_5_name">命運之輪 Wheel of Fortune</string>
    <string name="tarot_card_5_keyword">節奏轉動 / 緣分靠近 / 意外變化</string>
    <string name="tarot_card_5_meaning">這張牌帶著很強的變化感。近期可能會出現意料之外的聯絡、重新連上的關係，或原本停滯的互動忽然開始流動。</string>
    <string name="tarot_major_fool_name">愚者</string>
    <string name="tarot_major_fool_summary">代表新的開始、冒險與打開可能。解牌時常出現在你準備跳出舊節奏、願意重新相信或嘗試新關係的時候。</string>
    <string name="tarot_major_magician_name">魔術師</string>
    <string name="tarot_major_magician_summary">代表主動、創造力與把想法變成行動。常提醒你現在有能力表達、吸引、推動局面，不必一直等外界先給訊號。</string>
    <string name="tarot_major_high_priestess_name">女祭司</string>
    <string name="tarot_major_high_priestess_summary">代表直覺、內在感受與尚未說出口的真相。抽到時常表示答案其實已經在心裡，只是你還沒完全承認。</string>
    <string name="tarot_major_empress_name">皇后</string>
    <string name="tarot_major_empress_summary">代表滋養、被愛、豐盛與情感流動。常對應舒服的陪伴關係、被接住的感覺，或值得好好照顧自己的時期。</string>
    <string name="tarot_major_emperor_name">皇帝</string>
    <string name="tarot_major_emperor_summary">代表秩序、承諾、界線與穩定感。解牌時常指向需要把關係說清楚，或把生活重新整理回更可控的狀態。</string>
    <string name="tarot_major_hierophant_name">教皇</string>
    <string name="tarot_major_hierophant_summary">代表傳統、價值觀、規則與正式定義。常出現在關係開始談未來、談承諾，或你在意這段關係是否「有名分」的時候。</string>
    <string name="tarot_major_lovers_name">戀人</string>
    <string name="tarot_major_lovers_summary">代表選擇、連結、吸引與真心互動。它不只講愛情，也講你是否願意誠實面對自己真正想靠近的人與方向。</string>
    <string name="tarot_major_chariot_name">戰車</string>
    <string name="tarot_major_chariot_summary">代表推進、主動與控制方向。常表示事情要開始前進了，但也提醒你別只顧著衝，還要確認步調是不是對的。</string>
    <string name="tarot_major_strength_name">力量</string>
    <string name="tarot_major_strength_summary">代表溫柔的力量、穩住情緒與內在韌性。不是硬撐，而是用成熟和柔軟去接住自己與他人的起伏。</string>
    <string name="tarot_major_hermit_name">隱者</string>
    <string name="tarot_major_hermit_summary">代表沉澱、獨處與往內尋找答案。抽到時常表示先別急著向外追問，真正該釐清的是你內心到底要什麼。</string>
    <string name="tarot_major_wheel_name">命運之輪</string>
    <string name="tarot_major_wheel_summary">代表週期轉動、機會變化與緣分流動。它常暗示局勢不會一直卡住，新的轉機或意外變化正在靠近。</string>
    <string name="tarot_major_justice_name">正義</string>
    <string name="tarot_major_justice_summary">代表平衡、誠實、因果與看清真相。解牌時常提醒你回到對等和真實，不要只被情緒推著走。</string>
    <string name="tarot_major_hanged_man_name">倒吊人</string>
    <string name="tarot_major_hanged_man_summary">代表停下來、換角度與暫時懸置。不是沒進展，而是事情需要另一種看法，才能找到真正的出口。</string>
    <string name="tarot_major_death_name">死神</string>
    <string name="tarot_major_death_summary">代表結束、翻頁與舊模式退場。它通常不是字面上的壞，而是提醒你該放掉已經不適合的東西，才有新的可能。</string>
    <string name="tarot_major_temperance_name">節制</string>
    <string name="tarot_major_temperance_summary">代表調和、修復、配速與把情緒慢慢調回來。常出現在需要慢慢磨合、循序靠近的關係裡。</string>
    <string name="tarot_major_devil_name">惡魔</string>
    <string name="tarot_major_devil_summary">代表強烈執著、欲望、上癮感與被牽制。解牌時要看清楚：你現在抓著不放的，到底是愛，還是害怕失去。</string>
    <string name="tarot_major_tower_name">高塔</string>
    <string name="tarot_major_tower_summary">代表突然拆解、真相爆開與原本結構被打破。雖然不舒服，但常常是讓你離開假象、重新整理的必要過程。</string>
    <string name="tarot_major_star_name">星星</string>
    <string name="tarot_major_star_summary">代表希望、療癒、回暖與重新相信。這張牌常帶來溫柔的修復感，讓心慢慢回到可以期待的狀態。</string>
    <string name="tarot_major_moon_name">月亮</string>
    <string name="tarot_major_moon_summary">代表不安、潛意識、模糊訊號與情緒波動。抽到時要特別分辨，現在感受到的是事實，還是被放大的擔心。</string>
    <string name="tarot_major_sun_name">太陽</string>
    <string name="tarot_major_sun_summary">代表明朗、開心、被看見與互動升溫。這張牌通常很正向，常對應關係變亮、心情放鬆、事情更有把握。</string>
    <string name="tarot_major_judgement_name">審判</string>
    <string name="tarot_major_judgement_summary">代表覺醒、回頭整理與做出真正的決定。常出現在舊人舊事重回眼前，你需要給自己一個清楚答案的時候。</string>
    <string name="tarot_major_world_name">世界</string>
    <string name="tarot_major_world_summary">代表完成、整合、成熟與進入下一階段。它常表示某個循環快要走完了，你會帶著更多理解走向新的開始。</string>
    <string name="tarot_minor_wands_name">權杖牌組</string>
    <string name="tarot_minor_wands_summary">權杖對應行動力、熱情、慾望、動機與往前衝的能量。看到很多權杖時，通常表示事情正在推進，重點在你敢不敢行動。</string>
    <string name="tarot_minor_cups_name">聖杯牌組</string>
    <string name="tarot_minor_cups_summary">聖杯對應感情、情緒、關係流動與內心感受。它常出現在愛情、曖昧、友誼與需要共感、需要被理解的議題上。</string>
    <string name="tarot_minor_swords_name">寶劍牌組</string>
    <string name="tarot_minor_swords_summary">寶劍對應思考、溝通、壓力、衝突與判斷。抽到較多寶劍時，表示你正在面對現實、真相，或某些說不出口的拉扯。</string>
    <string name="tarot_minor_pentacles_name">錢幣牌組</string>
    <string name="tarot_minor_pentacles_summary">錢幣對應現實、安全感、資源、工作與長期經營。這組牌會提醒你把心拉回生活節奏、投入、承諾和具體結果。</string>
    <string name="tarot_rank_ace_name">Ace 一</string>
    <string name="tarot_rank_ace_summary">Ace 通常代表新的種子、第一個訊號與剛出現的可能性。它是起點，表示這個面向開始有能量流動。</string>
    <string name="tarot_rank_two_name">Two 二</string>
    <string name="tarot_rank_two_summary">Two 對應選擇、平衡與兩股力量的互動。常表示關係剛開始對接，或你需要在兩個方向之間做判斷。</string>
    <string name="tarot_rank_three_name">Three 三</string>
    <string name="tarot_rank_three_summary">Three 多半代表展開、合作與事情開始長出形狀。它常象徵互動增加、回應變多，或狀態開始成形。</string>
    <string name="tarot_rank_four_name">Four 四</string>
    <string name="tarot_rank_four_summary">Four 對應穩定、停住、建立結構，也可能是暫時不動。要看整體牌面，分辨它是安心感，還是卡住。</string>
    <string name="tarot_rank_five_name">Five 五</string>
    <string name="tarot_rank_five_summary">Five 常帶著變動、摩擦、挑戰與失衡。它提醒你事情開始遇到考驗，但也是看清問題的時刻。</string>
    <string name="tarot_rank_six_name">Six 六</string>
    <string name="tarot_rank_six_summary">Six 通常比五更回穩，常見於修復、流動、被支持或找到出口。它是從混亂走向較舒服節奏的過渡點。</string>
    <string name="tarot_rank_seven_name">Seven 七</string>
    <string name="tarot_rank_seven_summary">Seven 常對應拉扯、試探、策略與內心猶豫。事情未必表面化，但你已經感受到下一步不會那麼單純。</string>
    <string name="tarot_rank_eight_name">Eight 八</string>
    <string name="tarot_rank_eight_summary">Eight 多半代表加速、推進、重複練習或被困住的感覺。要搭配牌花看，是前進很快，還是壓力變重。</string>
    <string name="tarot_rank_nine_name">Nine 九</string>
    <string name="tarot_rank_nine_summary">Nine 通常進入收尾前的高張力階段，常見於快要看見成果、也快要感到疲累的時刻。</string>
    <string name="tarot_rank_ten_name">Ten 十</string>
    <string name="tarot_rank_ten_summary">Ten 代表一個循環走到尾聲，可能是圓滿，也可能是負擔已滿。它常提醒你：接下來要進入新的階段了。</string>
    <string name="tarot_rank_page_name">侍者 Page</string>
    <string name="tarot_rank_page_summary">Page 像剛起步的學習者，代表新消息、新態度、好奇心與比較年輕、比較直接的能量。</string>
    <string name="tarot_rank_knight_name">騎士 Knight</string>
    <string name="tarot_rank_knight_summary">Knight 代表推動、行進、行動中的角色。它通常比 Page 更有衝勁，也更容易把事情往前帶。</string>
    <string name="tarot_rank_queen_name">皇后 Queen</string>
    <string name="tarot_rank_queen_summary">Queen 對應成熟的內在掌握、情緒理解與穩定表達。她比較像把能量收在心裡，懂得如何柔軟地運用。</string>
    <string name="tarot_rank_king_name">國王 King</string>
    <string name="tarot_rank_king_summary">King 代表成熟的外在掌控、領導與定調能力。它常象徵一種更明確、更有決斷力的處理方式。</string>
    <string name="tarot_love_trend_1">最近的感情運勢偏向「先慢慢靠近，再逐步確認」。如果你正和某個人有來有往，不需要急著定義關係，先把互動節奏養穩，對方會更容易表現真心。</string>
    <string name="tarot_love_trend_2">這段時間很容易遇到舊情緒被重新翻動的狀態，像是想起過去的遺憾、舊對話，或忽然想聯絡某個人。與其壓住，不如趁這次看清自己到底還在意什麼。</string>
    <string name="tarot_love_trend_3">近期桃花不算少，但真正值得留意的是「有沒有穩定回應」。比起一時熱烈，更適合觀察誰願意在細節上持續靠近你。</string>
    <string name="tarot_love_trend_4">最近的感情走向比較像從模糊走向明朗。某段原本看不懂的互動，接下來很可能出現明確訊號，讓你知道該繼續、該等待，還是該轉身。</string>
    <string name="tarot_love_trend_5">如果你目前是單身，這段時間更適合先把自己的狀態照顧穩。當你不再急著尋找答案，反而比較容易遇到讓你舒服、也願意慢慢靠近的人。</string>

    <string name="synastry_title">關係默契合盤</string>
    <string name="synastry_subtitle">這裡用比較輕量的方式，把兩個人的相處節奏、情緒互動與長期磨合感做成一頁式摘要。</string>
    <string name="synastry_metric_1_title">情緒互接</string>
    <string name="synastry_metric_1_score">89 分</string>
    <string name="synastry_metric_1_body">你們之間最明顯的優勢是能接住彼此的情緒波動。一方低落時，另一方通常不會急著糾正，而是更容易先給陪伴感。</string>
    <string name="synastry_metric_2_title">溝通節奏</string>
    <string name="synastry_metric_2_score">76 分</string>
    <string name="synastry_metric_2_body">溝通上其實不缺話題，但容易在期待不同時出現節奏落差。只要把需求說清楚，不要靠猜，很多誤會都能少一半。</string>
    <string name="synastry_metric_3_title">長期磨合</string>
    <string name="synastry_metric_3_score">83 分</string>
    <string name="synastry_metric_3_body">這段關係不是沒有摩擦，而是屬於願意修正、願意回頭對齊的類型。只要雙方都沒有逃避，長期走下去的穩定度其實不低。</string>
    <string name="synastry_advice_title">這段關係最需要注意的地方</string>
    <string name="synastry_advice_body">你們最值得把握的是「願意理解彼此」這件事，但也要小心把很多情緒放在心裡不說。越在意彼此，越要把真實需求說出來，關係才不會卡在默默猜測裡。</string>

    <string name="soulmate_title">靈魂共振名單</string>
    <string name="soulmate_subtitle">這裡不是只看單一分數，而是把適合深聊、適合陪伴、適合慢慢熟起來的人放在一起，讓你感受不同類型的契合感。</string>
    <string name="soulmate_tips_title">如何判斷誰真的適合你</string>
    <string name="soulmate_tips_body">高契合不一定代表馬上就會發展成關係，但通常代表你和對方比較容易產生安心感。與其追求瞬間的熱度，不如觀察誰願意穩定回應你、也願意理解你真正在意的事。</string>

    <string name="hot_rooms_title">今晚的熱門陪伴房</string>
    <string name="hot_rooms_subtitle">這個頁面會集中展示目前最容易快速融入的房間，適合想直接加入聊天、又不想從零開始找話題的人。</string>
    <string name="hot_rooms_tips_title">怎麼挑第一個要進的房間</string>
    <string name="hot_rooms_tips_body">先看標籤是不是貼近你當下的情緒，再看在線人數是否符合你想要的節奏。人多的房間比較熱鬧，人少的房間通常更容易慢慢聊深一點。</string>

    <string name="divination_zone_title">測算與解讀入口</string>
    <string name="divination_zone_subtitle">這裡收的是偏測驗、塔羅與關係解析類的內容，適合帶著問題進來，快速找到可以幫你整理情緒與方向的入口。</string>
    <string name="divination_zone_item_body">「%1$s」適合拿來快速切一個角度看問題，目前示意價格為 %2$d 星幣。進去之後會先給你輕量結果，再決定要不要往更深的解析走。</string>
    <string name="divination_zone_tips_title">什麼時候適合做測算</string>
    <string name="divination_zone_tips_body">最適合的時機不是情緒最爆炸的當下，而是你已經知道自己卡在哪裡、只是需要一個更清楚的切角時。這樣拿到的結果會更有參考價值。</string>

    <string name="healing_night_title">晚間療癒陪伴場</string>
    <string name="healing_night_subtitle">這個分區更像慢節奏的夜晚角落，適合失眠、想說說話、或者只想在安靜的陪伴裡把心情放下來一點點。</string>
    <string name="healing_night_topic_1_title">深夜情緒整理</string>
    <string name="healing_night_topic_1_body">適合在情緒很多、腦袋停不下來的時候進來。這類內容通常不急著給答案，而是先陪你把感受說清楚。</string>
    <string name="healing_night_topic_2_title">慢慢聊日常</string>
    <string name="healing_night_topic_2_body">有時候真正需要的不是分析，而是有人陪你把今天發生的事從頭講一遍。這個主題更適合慢慢講、慢慢被接住。</string>
    <string name="healing_night_topic_3_title">睡前安定感</string>
    <string name="healing_night_topic_3_body">如果你在睡前特別容易想很多，這類夜話內容會更適合作為過渡，讓心情慢慢降下來，而不是把情緒帶進整晚的失眠裡。</string>
    <string name="healing_night_tips_title">進入夜話分區前的小提醒</string>
    <string name="healing_night_tips_body">不用勉強自己一次說很多。只要先從一句「我今天有點累」開始，節奏就會慢慢打開。夜裡的陪伴更重視安全感，而不是表達得多完整。</string>

    <string name="zodiac_detail_title">十二星座人格地圖</string>
    <string name="zodiac_detail_subtitle">這裡把 12 星座的人格氣質拆成更容易理解的短篇介紹，適合快速感受每個星座在關係、情緒與日常互動裡最鮮明的樣子。</string>
    <string name="chinese_zodiac_detail_title">十二生肖人格地圖</string>
    <string name="chinese_zodiac_detail_subtitle">這裡把 12 生肖常見的人格底色、相處節奏與情緒表達整理成一張地圖，適合快速感受每個生肖在人際與關係裡最明顯的樣子。</string>
    <string name="zodiac_aries_name">牡羊座</string>
    <string name="zodiac_aries_title">直接熱烈的行動派</string>
    <string name="zodiac_aries_summary">牡羊座的魅力在於反應快、熱情真，喜歡了就會靠近，不喜歡拐彎。情緒來得快也去得快，最受不了關係裡一直拖著不說清楚。</string>
    <string name="zodiac_taurus_name">金牛座</string>
    <string name="zodiac_taurus_title">慢熱穩定的安全感提供者</string>
    <string name="zodiac_taurus_summary">金牛座不一定會立刻表態，但一旦認定就很穩。他們重視日常照顧、實際陪伴和可預期的節奏，比起甜言蜜語，更相信長時間累積出的安心感。</string>
    <string name="zodiac_gemini_name">雙子座</string>
    <string name="zodiac_gemini_title">腦袋快、話題多的交流型人格</string>
    <string name="zodiac_gemini_summary">雙子座擅長聊天，也擅長在不同場景裡切換節奏。表面看起來輕鬆，其實很在意有沒有被理解。對他們來說，好的關係通常從有趣的對話開始。</string>
    <string name="zodiac_cancer_name">巨蟹座</string>
    <string name="zodiac_cancer_title">柔軟細膩的情緒接住者</string>
    <string name="zodiac_cancer_summary">巨蟹座常常先感覺到別人的情緒，再決定自己怎麼靠近。他們重感情、顧家，也很需要安全感。越在乎一個人，越容易把很多情緒收在心裡。</string>
    <string name="zodiac_leo_name">獅子座</string>
    <string name="zodiac_leo_title">自帶光感的主角型人格</string>
    <string name="zodiac_leo_summary">獅子座在關係裡很重視被看見、被珍惜，也很願意主動照顧別人。他們外表強勢，內心其實很在意回應。如果你願意真心欣賞，獅子會給出非常明亮的愛。</string>
    <string name="zodiac_virgo_name">處女座</string>
    <string name="zodiac_virgo_title">細節控與秩序感很強的照顧型人格</string>
    <string name="zodiac_virgo_summary">處女座擅長觀察細節，也擅長用實際方式照顧關係。他們不是冷淡，而是會先確認值不值得投入。看起來挑剔，其實只是很在意穩定與真誠。</string>
    <string name="zodiac_libra_name">天秤座</string>
    <string name="zodiac_libra_title">溫和體面、重視平衡的互動型人格</string>
    <string name="zodiac_libra_summary">天秤座很會維持氣氛，也很在意相處舒不舒服。他們不喜歡太衝突的場面，常常先顧全大局。真正的課題往往不是沒想法，而是如何更果斷地表達自己。</string>
    <string name="zodiac_scorpio_name">天蠍座</string>
    <string name="zodiac_scorpio_title">外冷內深的高濃度情感人格</string>
    <string name="zodiac_scorpio_summary">天蠍座的情感很深，不輕易把全部交出去。一旦信任，就會非常投入；一旦受傷，也很難假裝沒事。他們最重視的是關係裡的真心與忠誠。</string>
    <string name="zodiac_sagittarius_name">射手座</string>
    <string name="zodiac_sagittarius_title">自由感很強的真誠探索者</string>
    <string name="zodiac_sagittarius_summary">射手座喜歡輕鬆、真實、有空氣感的關係，不愛被綁太緊。看起來灑脫，其實很重視彼此能不能一起成長。越能讓他們做自己，越容易留下來。</string>
    <string name="zodiac_capricorn_name">摩羯座</string>
    <string name="zodiac_capricorn_title">理性克制的長期經營派</string>
    <string name="zodiac_capricorn_summary">摩羯座不一定很會說，但很會扛。他們常用行動去證明在乎，也習慣先把事情做好。真正靠近後會發現，他們其實比想像中更溫柔、更需要被理解。</string>
    <string name="zodiac_aquarius_name">水瓶座</string>
    <string name="zodiac_aquarius_title">獨特清醒的觀察型人格</string>
    <string name="zodiac_aquarius_summary">水瓶座很重視精神交流和邊界感，喜歡有趣、真誠又不窒息的關係。他們不是不投入，而是需要先確認彼此能不能在同一個頻率上相處。</string>
    <string name="zodiac_pisces_name">雙魚座</string>
    <string name="zodiac_pisces_title">感受力很強的浪漫共情者</string>
    <string name="zodiac_pisces_summary">雙魚座很容易被情緒和氛圍打動，也很會替別人著想。愛的時候很深，受傷時也容易把自己困住。對他們來說，被溫柔理解是一件很重要的事。</string>
    <string name="chinese_zodiac_rat_title">反應快、觀察細的靈巧型人格</string>
    <string name="chinese_zodiac_rat_summary">屬鼠的人通常反應快、會看氣氛，也擅長在複雜場景裡找到更聰明的做法。對關係很敏感，常常先觀察再靠近，真正信任後其實很願意照顧人。</string>
    <string name="chinese_zodiac_ox_title">穩定踏實的長線陪伴者</string>
    <string name="chinese_zodiac_ox_summary">屬牛的人節奏偏穩，不愛太浮動的關係，也不喜歡反覆試探。他們更相信日常累積出來的安全感，看起來慢熱，但一旦認定就很難輕易放手。</string>
    <string name="chinese_zodiac_tiger_title">有主見也有衝勁的行動派</string>
    <string name="chinese_zodiac_tiger_summary">屬虎的人通常很有自己的想法，做事果斷，也不太習慣委屈自己去迎合氣氛。關係裡重視真誠與痛快，如果被信任，他們往往會主動扛起保護與帶領的位置。</string>
    <string name="chinese_zodiac_rabbit_title">溫柔敏感的安撫型人格</string>
    <string name="chinese_zodiac_rabbit_summary">屬兔的人通常氣質柔和，擅長察覺別人的情緒，也很在意相處裡是否舒服、有分寸。他們不喜歡太硬碰硬的節奏，更適合在被理解、被善待的環境裡慢慢打開自己。</string>
    <string name="chinese_zodiac_dragon_title">自帶氣場的高標準人格</string>
    <string name="chinese_zodiac_dragon_summary">屬龍的人常常有明顯存在感，做事有企圖心，也希望自己活得有方向、有亮點。關係裡既想被看見，也希望對方有能力並肩同行，所以很重視彼此的成長感。</string>
    <string name="chinese_zodiac_snake_title">安靜克制的深層觀察者</string>
    <string name="chinese_zodiac_snake_summary">屬蛇的人通常不會一下子把自己全打開，而是先用觀察和感受來判斷值不值得靠近。他們情緒細、直覺強，關係裡討厭表面功夫，更偏好深度、真實和邊界清楚的互動。</string>
    <string name="chinese_zodiac_horse_title">自由感很強的直率人格</string>
    <string name="chinese_zodiac_horse_summary">屬馬的人行動快，情緒來得直接，也很需要空間感。他們喜歡真誠、清爽、有活力的關係，不喜歡被控制。越能讓他們保有自己原本的節奏，越容易相處長久。</string>
    <string name="chinese_zodiac_goat_title">柔軟細膩的共感型人格</string>
    <string name="chinese_zodiac_goat_summary">屬羊的人通常情感細膩，容易被氛圍和語氣影響，也很願意替別人著想。雖然外表溫和，但內心有自己的堅持。被好好接住時，他們會展現很強的陪伴力和理解力。</string>
    <string name="chinese_zodiac_monkey_title">機靈活躍的話題製造者</string>
    <string name="chinese_zodiac_monkey_summary">屬猴的人通常腦筋快、點子多，很會把氣氛帶活，也擅長在互動中找樂子。他們喜歡有趣、聰明、彼此接得住的交流，如果長期覺得無聊，很容易把心收回去。</string>
    <string name="chinese_zodiac_rooster_title">清楚俐落的秩序型人格</string>
    <string name="chinese_zodiac_rooster_summary">屬雞的人通常很有原則，說話直接，也很在意事情能不能被整理清楚。他們不一定圓滑，但常常很真。關係裡最受不了含糊和敷衍，反而欣賞坦白、可靠、有邏輯的人。</string>
    <string name="chinese_zodiac_dog_title">重承諾的守護型人格</string>
    <string name="chinese_zodiac_dog_summary">屬狗的人通常很重義氣，也很在意信任感建立後能不能被好好珍惜。他們對人真誠，願意在關係裡付出，但也對背叛特別敏感。越真心，越希望彼此能一直站在同一邊。</string>
    <string name="chinese_zodiac_pig_title">溫厚鬆弛的治癒型人格</string>
    <string name="chinese_zodiac_pig_summary">屬豬的人通常給人舒服、沒壓力的感覺，待人真誠，也比較少刻意和誰較勁。他們重視陪伴感和生活裡的踏實幸福，關係裡最珍惜的是被善待、被疼惜和被安穩接住。</string>
